diff --git a/api/Dockerfile b/api/Dockerfile
new file mode 100644
index 0000000..735330e
--- /dev/null
+++ b/api/Dockerfile
@@ -0,0 +1,19 @@
+FROM golang:1.26-bookworm AS build
+
+WORKDIR /src
+COPY go.mod go.sum ./
+RUN go mod download
+COPY . .
+RUN CGO_ENABLED=1 go build -o /out/roundtable-api ./api/cmd/server
+
+FROM debian:bookworm-slim
+
+RUN apt-get update \
+    && apt-get install --no-install-recommends -y ca-certificates git \
+    && rm -rf /var/lib/apt/lists/*
+WORKDIR /app
+COPY --from=build /out/roundtable-api /usr/local/bin/roundtable-api
+RUN mkdir -p /app/.roundtable
+EXPOSE 8080
+ENTRYPOINT ["roundtable-api"]
+CMD ["-addr", "0.0.0.0:8080", "-workspace-root", "/workspace", "-database", "/app/.roundtable/roundtable.db"]
diff --git a/api/docker-compose.yml b/api/docker-compose.yml
new file mode 100644
index 0000000..bb099ec
--- /dev/null
+++ b/api/docker-compose.yml
@@ -0,0 +1,13 @@
+services:
+  api:
+    build:
+      context: ..
+      dockerfile: api/Dockerfile
+    environment:
+      ROUNDTABLE_API_VERSION: ${ROUNDTABLE_API_VERSION:-dev}
+    ports:
+      - "${ROUNDTABLE_API_PORT:-8080}:8080"
+    volumes:
+      - ../.roundtable:/app/.roundtable
+      - ..:/workspace:ro
+    restart: unless-stopped
